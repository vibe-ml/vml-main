# Non-secret runtime settings for the processor code location on vml.pub.
# Install as /opt/dagster/configs/vml-processor-bertopic.env. Secrets
# (PWF_DATABASE_URL password, PWF_LABELING_API_KEY) belong in
# /opt/dagster/secrets/vml-processor-bertopic.env and are never committed.

PWF_UPSTREAM_SCHEMA=raw
PWF_ALEMBIC_NAME=bertopic
PWF_QDRANT_URL=http://qdrant:6333
PWF_QDRANT_COLLECTION=openalex_tabstract
PWF_HEADLINE_COLLECTION=discovery_headlines
PWF_EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
PWF_EMBEDDING_MODEL_REVISION=main
PWF_EMBEDDING_VECTOR_SIZE=1024
PWF_EMBEDDING_CONTEXT_WINDOW=4096
PWF_EMBEDDING_MAX_CONCURRENCY_PER_ENDPOINT=4
PWF_EMBEDDING_MAX_CONCURRENCY_OVERALL=6
PWF_EMBEDDING_ENDPOINT_FAILURE_LIMIT=3
PWF_EMBEDDING_ENDPOINT_MAX_RETRIES=2
PWF_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
PWF_TOPIC_RUN_MAX_CONCURRENT=1
PWF_MIN_CLUSTER_SIZE=15
PWF_UMAP_N_NEIGHBORS=15
PWF_CORPUS__SCOPE_IDS=["b92d45633a56c04a48b683d49876134ab6d75f2d2358433510be2d0f19beeed1"]
PWF_CORPUS__WORK_TYPES=["article","preprint","conference-paper"]
PWF_CORPUS__PUBLISHED_FROM=2024-01-01
PWF_CORPUS__PUBLISHED_TO=2026-09-28
PWF_CORPUS__EXCLUDED_DOMAIN_IDS=["https://openalex.org/domains/2"]
PWF_LABELING_MODEL=Qwen/Qwen3.6-35B-A3B
PWF_LABELING_MODEL_REVISION=main
PWF_LABELING_MAX_RETRIES=2
PWF_LABELING_RETRY_BACKOFF_SECONDS=0.5
PWF_LABELING_MAX_CONCURRENCY=4
